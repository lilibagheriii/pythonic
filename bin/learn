#!/usr/bin/env python3
"""learn: helper for the chapter logs in this repo.

Run `bin/learn -h` for the command list, or `bin/learn <command> -h` for details.
Uses only the standard library, so it works on Python 3.8 and newer.
"""
import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CURRICULUM_FILE = ROOT / "curriculum.json"
CURRENT_FILE = ROOT / ".current-chapter"
TEMPLATE_DIR = ROOT / "templates"
JUNK = shutil.ignore_patterns(".git", ".idea", ".venv", "venv", "__pycache__", "*.pyc", ".DS_Store",
                              ".pytest_cache", ".ipynb_checkpoints")

SECTIONS = {
    "exercises": "## Exercises",
    "sessions": "## Session log",
    "remarks": "## Remarks",
    "questions": "## Questions for mentor",
    "parked": "## Parked",
    "retro": "## Retro",
}
CHECKBOX = re.compile(r"^- \[( |x)\] ")
PLACEHOLDER = re.compile(r"^_.+_$")
STATUSES = ("not-started", "in-progress", "complete", "skipped")


# ---------------------------------------------------------------- helpers

def die(message):
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def today():
    return datetime.date.today().isoformat()


def slugify(text, sep="-"):
    return re.sub(r"[^a-z0-9]+", sep, text.lower()).strip(sep)


def normalize_id(text):
    """'pcc-2' and 'PCC-02' both become 'pcc-2'."""
    return re.sub(r"(?<![\d.])0+(?=\d)", "", text.strip().lower())


def rel(path):
    return path.relative_to(ROOT)


def fill(template, values):
    for key, value in values.items():
        template = template.replace("{{" + key + "}}", value)
    return template


# ---------------------------------------------------------------- chapters

class Chapter:
    """A chapter, project or lab from curriculum.json.

    Labs are listed under a phase's "labs" and are optional: `next` never moves into one.
    Each lab is one folder inside its phase, <phase dir>/labs/<source>/: the mentor's
    README.md (the walkthrough) and starter/ (files the learner gets a copy of), then the
    learner's LOG.md and exercises/ next to them once the lab is started.
    """

    def __init__(self, entry, phase, kind=None):
        self.id = entry["id"]
        self.title = entry["title"]
        self.kind = kind or entry.get("kind", "chapter")
        self.goals = entry.get("goals", [])
        self.book = entry.get("book", phase.get("book", ""))
        self.phase = phase
        self.needs = entry.get("needs", "")
        if self.kind == "lab":
            self.dir = ROOT / phase["dir"] / "labs" / entry["source"]
            self.starter = self.dir / "starter"
            self.ref = entry.get("ref", f"{phase['dir']}/labs/{entry['source']}/README.md")
        else:
            self.ref = entry.get("ref", "")
            self.dir = ROOT / phase["dir"] / f"{self.id}-{slugify(self.title)}"
        self.log = self.dir / "LOG.md"

    @property
    def work_dir(self):
        return self.dir / ("src" if self.kind == "project" else "exercises")

    @property
    def started(self):
        return self.log.exists()

    def read(self):
        if not self.started:
            die(f"{self.id} hasn't been started yet. Run `bin/learn start {self.id}` first.")
        return self.log.read_text(encoding="utf-8")

    def write(self, text):
        self.log.write_text(text, encoding="utf-8")

    def create_log(self):
        """Make the chapter folder and its LOG.md from the template as it is right now.

        Logs are created only when a chapter is started, so editing templates/LOG.md changes
        every chapter started after that. A kind-specific template (templates/LOG.project.md)
        is used instead when it exists.
        """
        template = TEMPLATE_DIR / f"LOG.{self.kind}.md"
        if not template.exists():
            template = TEMPLATE_DIR / "LOG.md"
        if self.kind == "lab":
            default_goals = ["Work through every step of the walkthrough",
                             "Explain one finding to the mentor in plain words"]
        else:
            default_goals = ["Do every exercise in this reading", "Explain the main idea out loud to the mentor"]
        self.dir.mkdir(parents=True, exist_ok=True)
        self.write(fill(template.read_text(encoding="utf-8"), {
            "id": self.id,
            "title": self.title,
            "book": self.book,
            "ref": self.ref,
            "phase": self.phase["title"],
            "needs": self.needs or "—",
            "walkthrough": "README.md",
            "goals_heading": "Definition of done" if self.kind == "project" else "Goals",
            "goals": "\n".join(f"- [ ] {goal}" for goal in self.goals or default_goals),
        }))
        print(f"created {rel(self.log)} from {rel(template)}")
        if self.kind == "lab":
            self.copy_starter()

    def copy_starter(self):
        """Copy the lab's starter/ files into the learner's exercises/ folder, next to them."""
        if not self.starter.is_dir():
            return
        shutil.copytree(self.starter, self.work_dir, ignore=JUNK, dirs_exist_ok=True)
        copied = sorted(p.name for p in self.work_dir.iterdir()) if self.work_dir.exists() else []
        if copied:
            print(f"copied starter files into {rel(self.work_dir)}/: {', '.join(copied)}")


def load_curriculum():
    return json.loads(CURRICULUM_FILE.read_text(encoding="utf-8"))


def save_curriculum(data):
    """Write curriculum.json in its hand-edited layout: one chapter or lab per line."""
    out = ["{", '  "phases": [']
    for pi, phase in enumerate(data["phases"]):
        out.append("    {")
        keys = list(phase)
        for ki, key in enumerate(keys):
            comma = "," if ki < len(keys) - 1 else ""
            value = phase[key]
            if isinstance(value, list):
                out.append(f'      "{key}": [')
                for ei, entry in enumerate(value):
                    out.append("        " + json.dumps(entry, ensure_ascii=False) + ("," if ei < len(value) - 1 else ""))
                out.append(f"      ]{comma}")
            else:
                out.append(f'      "{key}": {json.dumps(value, ensure_ascii=False)}{comma}')
        out.append("    }" + ("," if pi < len(data["phases"]) - 1 else ""))
    out += ["  ]", "}", ""]
    CURRICULUM_FILE.write_text("\n".join(out), encoding="utf-8")


def load_chapters():
    """Every chapter in order; each phase's labs come after its chapters."""
    chapters = []
    for phase in load_curriculum()["phases"]:
        chapters += [Chapter(entry, phase) for entry in phase["chapters"]]
        chapters += [Chapter(entry, phase, kind="lab") for entry in phase.get("labs", [])]
    return chapters


def next_chapter(ch, chapters):
    """Where `next` goes after `ch`. Labs are never picked.

    After a chapter: the first chapter after it that hasn't been started.
    After a lab: back to the first chapter in progress, else the first one not started.
    """
    main = [c for c in chapters if c.kind != "lab"]
    if ch.kind == "lab":
        statuses = [(c, counts(c)["status"]) for c in main]
        return (next((c for c, s in statuses if s == "in-progress"), None)
                or next((c for c, s in statuses if s == "not-started"), None))
    after = chapters[[c.id for c in chapters].index(ch.id) + 1:]
    return next((c for c in after if c.kind != "lab" and counts(c)["status"] == "not-started"), None)


def lab_hints(ch, chapters):
    """Lines to print when `ch` is completed: labs it unlocked, and unfinished labs if its phase is done."""
    labs = [c for c in chapters if c.kind == "lab" and not c.started]
    lines = [f"New lab ready: {lab.id} · {lab.title}. Try it any time with `bin/learn session {lab.id}`."
             for lab in labs if lab.needs and normalize_id(lab.needs) == normalize_id(ch.id)]
    phase_main = [c for c in chapters if c.phase["dir"] == ch.phase["dir"] and c.kind != "lab"]
    if ch.kind != "lab" and all(counts(c)["status"] in ("complete", "skipped") for c in phase_main):
        open_labs = [c for c in chapters if c.phase["dir"] == ch.phase["dir"] and c.kind == "lab"
                     and counts(c)["status"] not in ("complete", "skipped")]
        if open_labs:
            lines.append("That finishes the phase's chapters. Labs from this phase you haven't finished yet: "
                         + ", ".join(c.id for c in open_labs) + ". See `bin/learn labs`.")
    return lines


def find_chapter(arg, chapters=None):
    chapters = chapters or load_chapters()
    wanted = normalize_id(arg)
    for ch in chapters:
        if normalize_id(ch.id) == wanted:
            return ch
    matches = [ch for ch in chapters
               if normalize_id(ch.id).startswith(wanted) or wanted in ch.dir.name]
    if len(matches) == 1:
        return matches[0]
    if matches:
        die(f"'{arg}' matches several chapters: {', '.join(c.id for c in matches)}")
    die(f"no chapter called '{arg}'. Run `bin/learn status` to see the ids.")


def mark_started(ch):
    """Create the log if needed and mark the chapter in progress. Doesn't change the current chapter."""
    if not ch.started:
        ch.create_log()
    text = ch.read()
    if get_field(text, "Status") != "complete":
        text = set_field(text, "Status", "in-progress")
    if get_field(text, "Started") in ("", "—"):
        text = set_field(text, "Started", today())
    ch.write(text)


def current_chapter(args, create=False):
    """The chapter a command works on: -c <id> if given, else the current chapter.

    With create=True (commands that add something: ex, note, ask, park, session), the
    first use of a side log through -c starts it, without switching the current chapter.
    """
    if getattr(args, "chapter", None):
        ch = find_chapter(args.chapter)
        if create and not ch.started:
            mark_started(ch)
        return ch
    if CURRENT_FILE.exists() and CURRENT_FILE.read_text().strip():
        return find_chapter(CURRENT_FILE.read_text().strip())
    die("no chapter picked yet. Start today with `bin/learn session <id>`, e.g. `bin/learn session pcc-00`.")


# ---------------------------------------------------------------- LOG.md editing

def get_field(text, name):
    match = re.search(rf"^\*\*{name}:\*\* *(.*)$", text, re.M)
    return match.group(1).strip() if match else ""


def set_field(text, name, value):
    pattern = rf"^(\*\*{name}:\*\*).*$"
    if re.search(pattern, text, re.M):
        return re.sub(pattern, lambda m: f"{m.group(1)} {value}", text, count=1, flags=re.M)
    lines = text.split("\n")          # a template without this field: add it under the title
    lines.insert(1, f"**{name}:** {value}")
    return "\n".join(lines)


def section_range(lines, key):
    """(start, end) line numbers of a section, or (None, None) if the log doesn't have it."""
    heading = SECTIONS[key]
    start = next((i for i, line in enumerate(lines) if line.strip() == heading), None)
    if start is None:
        return None, None
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return start, end


def append_entry(text, key, entry):
    """Add `entry` to the end of a section, removing the `_None yet._` placeholder.

    If the template the log came from has no such section, it is added at the end.
    """
    lines = text.split("\n")
    start, end = section_range(lines, key)
    if start is None:
        while lines and not lines[-1].strip():
            lines.pop()
        lines += ["", SECTIONS[key]]
        start, end = len(lines) - 1, len(lines)
    body = [line for line in lines[start + 1:end] if not PLACEHOLDER.match(line.strip())]
    while body and not body[0].strip():
        body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    has_entries = any(not line.lstrip().startswith("<!--") for line in body)
    gap = [""] if key == "sessions" and has_entries else []
    lines[start + 1:end] = body + gap + entry.split("\n") + [""]
    return "\n".join(lines)


def checkbox_items(text, key):
    """Top-level `- [ ]` / `- [x]` lines in a section: list of (line_number, done, line)."""
    lines = text.split("\n")
    start, end = section_range(lines, key)
    if start is None:
        return []
    items = []
    for i in range(start + 1, end):
        match = CHECKBOX.match(lines[i])
        if match:
            items.append((i, match.group(1) == "x", lines[i]))
    return items


def tick_item(text, key, number, suffix):
    open_items = [item for item in checkbox_items(text, key) if not item[1]]
    if not 1 <= number <= len(open_items):
        die(f"there is no open item #{number}. There are {len(open_items)} open.")
    line_no, _, line = open_items[number - 1]
    lines = text.split("\n")
    lines[line_no] = line.replace("- [ ] ", "- [x] ", 1) + suffix
    return "\n".join(lines), line, line_no


def strip_checkbox(line):
    return CHECKBOX.sub("", line)


def counts(ch):
    if not ch.started:
        return {"status": "not-started", "ex_done": 0, "ex_total": 0, "parked": 0, "questions": 0}
    text = ch.read()
    exercises = checkbox_items(text, "exercises")
    return {
        "status": get_field(text, "Status") or "not-started",
        "ex_done": sum(1 for _, done, _ in exercises if done),
        "ex_total": len(exercises),
        "parked": sum(1 for _, done, _ in checkbox_items(text, "parked") if not done),
        "questions": sum(1 for _, done, _ in checkbox_items(text, "questions") if not done),
    }


# ---------------------------------------------------------------- commands

def cmd_start(args):
    ch = find_chapter(args.id)
    if ch.started and get_field(ch.read(), "Status") == "complete":
        print(f"note: {ch.id} is already complete. Making it current anyway.")
    mark_started(ch)
    CURRENT_FILE.write_text(ch.id + "\n")
    print(f"▶ {ch.id} · {ch.title} is now your current chapter.")
    print(f"  Log:       {rel(ch.log)}")
    later = "" if ch.work_dir.exists() else "  (created by your first `bin/learn ex`)"
    print(f"  Exercises: {rel(ch.work_dir)}/{later}")
    print(f"  {'Walkthrough' if ch.kind == 'lab' else 'Reading'}:   {ch.ref}")
    if ch.kind == "lab" and ch.needs and counts(find_chapter(ch.needs))["status"] != "complete":
        print(f"  Heads up: this lab builds on {ch.needs}, which isn't complete yet.")


def cmd_ex(args):
    ch = current_chapter(args, create=True)
    ex_id = args.id.strip()
    title = " ".join(args.title).strip()
    text = ch.read()
    for _, _, line in checkbox_items(text, "exercises"):
        if re.match(rf"{re.escape(ex_id)}(\s|$)", strip_checkbox(line)):
            die(f"exercise {ex_id} is already in {rel(ch.log)}.")
    if ch.kind == "project" and title:
        name = slugify(title, "_") + ".py"          # e.g. src/storage.py, importable as a module
    else:
        name = "ex_" + slugify(f"{ex_id} {title}", "_") + ".py"
    path = ch.work_dir / name
    ch.work_dir.mkdir(parents=True, exist_ok=True)
    if not path.exists():
        label = f"Exercise {ex_id}" + (f": {title}" if title else "")
        path.write_text(fill((TEMPLATE_DIR / "exercise.py").read_text(encoding="utf-8"), {
            "label": label, "book": ch.book, "ref": ch.ref,
            "chapter_id": ch.id, "chapter_title": ch.title,
        }), encoding="utf-8")
    link = f"{ch.work_dir.name}/{name}"
    entry = f"- [ ] {ex_id}" + (f" — {title}" if title else "") + f" → [{name}]({link})"
    ch.write(append_entry(text, "exercises", entry))
    print(f"created {rel(path)}")
    print(f"When it works: bin/learn done {ex_id}")


def cmd_done(args):
    ch = current_chapter(args)
    text = ch.read()
    for line_no, done, line in checkbox_items(text, "exercises"):
        if re.match(rf"{re.escape(args.id)}(\s|$)", strip_checkbox(line)):
            if done:
                die(f"exercise {args.id} is already ticked off.")
            lines = text.split("\n")
            lines[line_no] = line.replace("- [ ] ", "- [x] ", 1) + f" ✓ {today()}"
            ch.write("\n".join(lines))
            c = counts(ch)
            print(f"✓ {args.id} done. {ch.id}: {c['ex_done']}/{c['ex_total']} exercises.")
            return
    die(f"no exercise {args.id} in {ch.id}. Add it with `bin/learn ex {args.id} \"title\"`.")


def cmd_note(args):
    ch = current_chapter(args, create=True)
    ch.write(append_entry(ch.read(), "remarks", f"- ({today()}) {' '.join(args.text)}"))
    print(f"remark added to {rel(ch.log)}")


def cmd_ask(args):
    ch = current_chapter(args, create=True)
    ch.write(append_entry(ch.read(), "questions", f"- [ ] ({today()}) {' '.join(args.text)}"))
    print(f"question added to {rel(ch.log)}. Run `bin/sync` so your mentor sees it.")


def cmd_answered(args):
    ch = current_chapter(args)
    answer = " ".join(args.answer).strip()
    text, line, line_no = tick_item(ch.read(), "questions", args.number, f" — answered {today()}")
    if answer:
        lines = text.split("\n")
        lines.insert(line_no + 1, f"  - **Answer:** {answer}")
        text = "\n".join(lines)
    ch.write(text)
    print(f"marked answered: {strip_checkbox(line)}")


def cmd_park(args):
    ch = current_chapter(args, create=True)
    ch.write(append_entry(ch.read(), "parked", f"- [ ] ({today()}) {' '.join(args.text)}"))
    print(f"parked in {ch.id}. See everything parked with `bin/learn parked`.")


def cmd_unpark(args):
    ch = current_chapter(args)
    note = " ".join(args.note).strip()
    suffix = f" — done {today()}" + (f": {note}" if note else "")
    text, line, _ = tick_item(ch.read(), "parked", args.number, suffix)
    ch.write(text)
    print(f"unparked: {strip_checkbox(line)}")


def list_open(key, label, command):
    found = 0
    for ch in load_chapters():
        if not ch.log.exists():
            continue
        open_items = [line for _, done, line in checkbox_items(ch.read(), key) if not done]
        if open_items:
            print(f"\n{ch.id} · {ch.title}")
            for n, line in enumerate(open_items, 1):
                print(f"  #{n}  {strip_checkbox(line)}")
            found += len(open_items)
    if found:
        print(f"\n{found} open {label}. Close one with `bin/learn {command} <n> -c <chapter>`.")
    else:
        print(f"No open {label}.")


def cmd_parked(args):
    list_open("parked", "parked item(s)", "unpark")


def cmd_questions(args):
    list_open("questions", "question(s)", "answered")


def cmd_session(args):
    if args.id:
        cmd_start(argparse.Namespace(id=args.id))   # pick the chapter first, then log the session in it
        print()
        ch = find_chapter(args.id)
    else:
        ch = current_chapter(args, create=True)
    hours = f" ({args.hours}h)" if args.hours else ""
    entry = "\n".join([
        f"### {today()}{hours}",
        "- **Did:** ",
        "- **Learned:** ",
        "- **Confusing:** ",
        "- **Next time:** ",
    ])
    ch.write(append_entry(ch.read(), "sessions", entry))
    print(f"session entry added. Fill it in: {rel(ch.log)}")


def cmd_complete(args):
    ch = find_chapter(args.id) if args.id else current_chapter(args)
    text = ch.read()
    if getattr(args, "move_on", False) and get_field(text, "Status") == "complete":
        return next_chapter(ch, load_chapters())
    problems = []
    open_ex = [strip_checkbox(l) for _, done, l in checkbox_items(text, "exercises") if not done]
    open_parked = [strip_checkbox(l) for _, done, l in checkbox_items(text, "parked") if not done]
    open_q = [strip_checkbox(l) for _, done, l in checkbox_items(text, "questions") if not done]
    if open_ex:
        problems.append(f"{len(open_ex)} exercise(s) not done: " + "; ".join(open_ex))
    if open_parked:
        problems.append(f"{len(open_parked)} parked item(s) still open: " + "; ".join(open_parked))
    if open_q:
        problems.append(f"{len(open_q)} question(s) not answered yet")
    lines = text.split("\n")
    start, end = section_range(lines, "retro")
    if start is not None and any(re.match(r"^- \*\*[^*]+:\*\*\s*$", line) for line in lines[start:end]):
        problems.append("the Retro section isn't filled in")
    if problems and not args.force:
        print(f"{ch.id} isn't ready to complete:")
        for p in problems:
            print(f"  • {p}")
        print("Fix those, or park what's left and run again with --force to finish anyway.")
        sys.exit(1)
    text = set_field(text, "Status", "complete")
    text = set_field(text, "Completed", today())
    if get_field(text, "Started") in ("", "—"):
        text = set_field(text, "Started", today())
    ch.write(text)
    print(f"🎉 {ch.id} · {ch.title} is complete.")
    chapters = load_chapters()
    for line in lab_hints(ch, chapters):
        print(line)
    upcoming = next_chapter(ch, chapters)
    if getattr(args, "move_on", False):
        return upcoming
    if upcoming:
        print(f"Next up: {upcoming.id} · {upcoming.title}. Pick it at the start of your next session: `bin/learn session {upcoming.id}`.")
    return upcoming


def cmd_next(args):
    """Close the current chapter (same checks as complete) and move to the next one."""
    args.id = None
    args.move_on = True
    upcoming = cmd_complete(args)
    if not upcoming:
        print("That was the last chapter in curriculum.json. Nothing left to start.")
        return
    print()
    cmd_start(argparse.Namespace(id=upcoming.id))


def cmd_skip(args):
    ch = find_chapter(args.id)
    if not ch.started:
        ch.create_log()   # keeps a record of the skip and the reason
    text = set_field(ch.read(), "Status", "skipped")
    reason = " ".join(args.reason).strip() or "not on my chosen track"
    ch.write(append_entry(text, "remarks", f"- ({today()}) Skipped: {reason}"))
    print(f"{ch.id} marked skipped.")


def cmd_status(args):
    chapters = load_chapters()
    current = CURRENT_FILE.read_text().strip() if CURRENT_FILE.exists() else ""
    marks = {"not-started": "·", "in-progress": "…", "complete": "✓", "skipped": "–"}
    phase_title = None
    labs_heading_for = None
    totals = {s: 0 for s in STATUSES}
    labs_done = labs_total = 0
    parked = questions = 0
    for ch in chapters:
        c = counts(ch)
        if ch.kind == "lab":
            labs_total += 1
            labs_done += c["status"] == "complete"
        else:
            totals[c["status"]] = totals.get(c["status"], 0) + 1
        parked += c["parked"]
        questions += c["questions"]
        if args.phase is not None and not ch.phase["dir"].startswith(f"phase-{args.phase}"):
            continue
        if ch.phase["title"] != phase_title:
            phase_title = ch.phase["title"]
            print(f"\n{phase_title}")
            phase_lectures = lectures(ch.phase)
            if phase_lectures:
                print(f"   Lectures: {len(phase_lectures)} in {ch.phase['dir']}/lectures/ (see `bin/learn lectures`)")
        if ch.kind == "lab" and labs_heading_for != phase_title:
            labs_heading_for = phase_title
            print("   Labs (optional, real-world walkthroughs from your mentor)")
        if ch.kind == "lab" and c["status"] == "not-started":
            c["status"] = lab_readiness(ch)
        pointer = "▶" if ch.id == current else " "
        title = ch.title if len(ch.title) <= 38 else ch.title[:37] + "…"
        extras = []
        if c["ex_total"]:
            extras.append(f"ex {c['ex_done']}/{c['ex_total']}")
        if c["parked"]:
            extras.append(f"parked {c['parked']}")
        if c["questions"]:
            extras.append(f"questions {c['questions']}")
        print(f" {pointer} {marks.get(c['status'], '·')} {ch.id:<26} {title:<38} {c['status']:<12} {'  '.join(extras)}")
    done = totals["complete"] + totals["skipped"]
    total = sum(totals.values())
    labs = f" Labs: {labs_done}/{labs_total} done." if labs_total else ""
    print(f"\n{done}/{total} done ({totals['complete']} complete, {totals['skipped']} skipped), "
          f"{totals['in-progress']} in progress. Open: {parked} parked, {questions} question(s).{labs}")


def lab_readiness(lab):
    """'ready' if the chapter the lab needs is done (or it needs none), else 'after <id>'."""
    if not lab.needs:
        return "ready"
    return "ready" if counts(find_chapter(lab.needs))["status"] in ("complete", "skipped") else f"after {lab.needs}"


def cmd_labs(args):
    labs = [c for c in load_chapters() if c.kind == "lab"]
    if not labs:
        print("No labs yet.")
        return
    phase_title = None
    for lab in labs:
        if lab.phase["title"] != phase_title:
            phase_title = lab.phase["title"]
            print(f"\n{phase_title}")
        status = counts(lab)["status"]
        if status == "not-started":
            status = lab_readiness(lab)
        print(f"  {lab.id:<26} {lab.title[:40]:<40} {status}")
        print(f"  {'':<26} {lab.ref}")
    print("\nStart one with `bin/learn session <id>`. When it's done, `bin/learn next` takes you back to your chapter.")


def current_phase(chapters):
    """The phase of the current chapter, else of the furthest chapter started, else the first."""
    phases = load_curriculum()["phases"]
    current = CURRENT_FILE.read_text().strip() if CURRENT_FILE.exists() else ""
    ch = find_chapter(current, chapters) if current else None
    if ch is None:
        started = [c for c in chapters if c.kind != "lab" and c.started]
        ch = started[-1] if started else None
    return next(i for i, p in enumerate(phases) if ch is None or p["dir"] == ch.phase["dir"])


def readme_title(folder):
    readme = folder / "README.md"
    if readme.exists():
        for line in readme.read_text(encoding="utf-8").splitlines():
            if line.startswith("# "):
                return line[2:].strip()
    return folder.name.replace("-", " ").replace("_", " ").strip().capitalize()


def cmd_lab_add(args):
    """Mentor: copy a folder in as <phase dir>/labs/<name>/ and list it in curriculum.json."""
    src = Path(args.folder).expanduser().resolve()
    if not src.is_dir():
        die(f"{args.folder} isn't a folder.")
    data = load_curriculum()
    chapters = load_chapters()
    phases = data["phases"]
    index = phase_index(phases, args.phase) if args.phase is not None else current_phase(chapters)
    phase = phases[index]
    folder = slugify(src.name)
    lab_id = args.id or f"lab-{folder}"
    dest = ROOT / phase["dir"] / "labs" / folder
    labs = phase.setdefault("labs", [])
    existing = next((e for e in labs if e["id"] == lab_id), None)
    if existing and not args.update:
        die(f"{lab_id} is already a lab. To copy in a newer version of the folder, add --update.")
    if not existing and any(normalize_id(c.id) == normalize_id(lab_id) for c in chapters):
        die(f"'{lab_id}' is already used in curriculum.json. Pick another with --id.")
    if args.needs:
        args.needs = find_chapter(args.needs, chapters).id

    if src != dest:
        if dest.exists() and not existing:
            die(f"{rel(dest)} already exists. Pick another name with --id, or remove it first.")
        if dest.resolve() in src.parents or src in dest.resolve().parents:
            die("the folder can't be inside its own destination.")
        import_lab_files(src, dest)
    readme = dest / "README.md"
    title = args.title or readme_title(dest)
    if not readme.exists():
        readme.write_text(f"# {title}\n\n"
                          "<!-- The walkthrough the learner follows: the real-world problem, then the steps\n"
                          "     and questions. Files in starter/ are copied into the learner's exercises/\n"
                          "     when they start the lab. -->\n", encoding="utf-8")
        print(f"note: the folder had no README.md, so {rel(readme)} was created. Write the walkthrough there.")

    entry = existing or {"id": lab_id}
    entry["title"] = title
    entry["source"] = folder
    if args.needs:
        entry["needs"] = args.needs
    if args.goal:
        entry["goals"] = args.goal
    if not existing:
        labs.append(entry)
    save_curriculum(data)

    starter = dest / "starter"
    starters = sorted(p.name for p in starter.iterdir()) if starter.is_dir() else []
    print(f"✓ {'Updated' if existing else 'Added'} {lab_id} · {title} in {phase['title']}")
    print(f"  Walkthrough:   {rel(readme)}")
    print(f"  Starter files: {', '.join(starters) if starters else 'none'}")
    if existing:
        print("  Learners who already started it keep their copy; the update reaches new starts.")
    print("  Run `bin/sync` to send it to the learner.")


def import_lab_files(src, dest):
    """README.md goes to dest/; everything else goes to dest/starter/ (a starter/ folder as is)."""
    names = [p.name for p in src.iterdir()]
    skip = set(JUNK(str(src), names))
    dest.mkdir(parents=True, exist_ok=True)
    for name in sorted(set(names) - skip):
        item = src / name
        if name == "README.md" and item.is_file():
            target = dest / name
        elif name == "starter" and item.is_dir():
            target = dest / "starter"
        else:
            target = dest / "starter" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        if item.is_dir():
            shutil.copytree(item, target, ignore=JUNK, dirs_exist_ok=True)
        else:
            shutil.copy2(item, target)


def phase_index(phases, number):
    index = next((i for i, p in enumerate(phases) if p["dir"].startswith(f"phase-{number}-")), None)
    if index is None:
        die(f"there's no phase {number}. Phases: {', '.join(p['dir'] for p in phases)}")
    return index


def find_lab_entry(data, wanted):
    """(phase, entry) for a lab id. 'titanic' finds 'lab-titanic-survivors' if it's the only match."""
    wanted = normalize_id(wanted)
    found = [(phase, entry) for phase in data["phases"] for entry in phase.get("labs", [])]
    exact = [f for f in found if normalize_id(f[1]["id"]) == wanted]
    matches = exact or [f for f in found if wanted in normalize_id(f[1]["id"])]
    if len(matches) == 1:
        return matches[0]
    if matches:
        die(f"'{wanted}' matches several labs: {', '.join(e['id'] for _, e in matches)}")
    die(f"no lab called '{wanted}'. See them with `bin/learn lab list`.")


def cmd_lab_list(args):
    """Mentor: every lab with its source, setup and the learner's progress."""
    labs = [c for c in load_chapters() if c.kind == "lab"]
    if not labs:
        print("No labs yet. Add one with `bin/learn lab add <folder>`.")
        return
    phase_title = None
    for lab in labs:
        if lab.phase["title"] != phase_title:
            phase_title = lab.phase["title"]
            print(f"\n{phase_title}")
        c = counts(lab)
        status = c["status"] if c["status"] != "not-started" else f"not started ({lab_readiness(lab)})"
        progress = [status]
        if c["ex_total"]:
            progress.append(f"ex {c['ex_done']}/{c['ex_total']}")
        if c["questions"]:
            progress.append(f"questions {c['questions']}")
        if c["parked"]:
            progress.append(f"parked {c['parked']}")
        starters = sorted(p.name for p in lab.starter.iterdir()) if lab.starter.is_dir() else []
        files = ", ".join(starters) if starters else "none"
        if not (lab.dir / "README.md").exists():
            files += "  (no README.md: the walkthrough is missing!)"
        print(f"  {lab.id} · {lab.title}")
        print(f"      learner:  {', '.join(progress)}")
        print(f"      folder:   {rel(lab.dir)}/")
        print(f"      starters: {files}")
        if lab.needs or lab.goals:
            print(f"      needs:    {lab.needs or '—'}    goals: {len(lab.goals) or 'default'}")


def cmd_lab_remove(args):
    """Mentor: take a lab out of curriculum.json and delete its folder (the learner's work stays)."""
    data = load_curriculum()
    phase, entry = find_lab_entry(data, args.id)
    lab = Chapter(entry, phase, kind="lab")
    if lab.started and not args.force:
        die(f"the learner has started {lab.id} ({rel(lab.dir)}/). Removing it deletes your README.md and "
            "starter/ but keeps their LOG.md and exercises/, and it disappears from `status` and `labs`. "
            "Add --force to remove it anyway.")
    phase["labs"].remove(entry)
    if not phase["labs"]:
        del phase["labs"]
    save_curriculum(data)
    labs_dir = (ROOT / phase["dir"] / "labs").resolve()
    if lab.dir.is_dir() and lab.dir.resolve().parent == labs_dir:
        if lab.started:
            shutil.rmtree(lab.starter, ignore_errors=True)
            if (lab.dir / "README.md").exists():
                (lab.dir / "README.md").unlink()
            removed = f" and deleted the walkthrough and starter/ from {rel(lab.dir)}/"
        else:
            shutil.rmtree(lab.dir)
            removed = f" and deleted {rel(lab.dir)}/"
            try:
                labs_dir.rmdir()          # the phase's labs/ folder, if that was its last lab
            except OSError:
                pass
    else:
        removed = ""
    print(f"✓ Removed {lab.id} from curriculum.json{removed}.")
    if lab.started:
        print(f"  The learner's LOG.md and exercises/ in {rel(lab.dir)}/ are untouched.")
    print(f"  Changed your mind? If the lab was already committed, `git restore curriculum.json {rel(lab.dir)}` brings it back.")


def cmd_lab_edit(args):
    """Mentor: change a lab's title, needs, goals or phase without copying files again."""
    data = load_curriculum()
    phase, entry = find_lab_entry(data, args.id)
    lab = Chapter(entry, phase, kind="lab")
    changes = []
    if args.title:
        entry["title"] = args.title
        changes.append(f"title → {args.title}")
    if args.no_needs:
        entry.pop("needs", None)
        changes.append("needs → none")
    elif args.needs:
        entry["needs"] = find_chapter(args.needs).id
        changes.append(f"needs → {entry['needs']}")
    if args.no_goals:
        entry.pop("goals", None)
        changes.append("goals → the default ones")
    elif args.goal:
        entry["goals"] = args.goal
        changes.append(f"goals → {len(args.goal)} goal(s)")
    if args.phase is not None:
        new_phase = data["phases"][phase_index(data["phases"], args.phase)]
        if new_phase is not phase:
            if lab.started:
                die(f"the learner has started {lab.id}, and their work is in {rel(lab.dir)}/. "
                    "Leave it in this phase, or remove it and add it again.")
            dest = ROOT / new_phase["dir"] / "labs" / entry["source"]
            if dest.exists():
                die(f"{rel(dest)} already exists.")
            if lab.dir.is_dir():
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(lab.dir), str(dest))
                try:
                    lab.dir.parent.rmdir()
                except OSError:
                    pass
            phase["labs"].remove(entry)
            if not phase["labs"]:
                del phase["labs"]
            new_phase.setdefault("labs", []).append(entry)
            changes.append(f"phase → {new_phase['dir']} (folder moved to {rel(dest)}/)")
    if not changes:
        die("nothing to change. Pass --title, --needs, --no-needs, --goal, --no-goals or --phase.")
    save_curriculum(data)
    print(f"✓ Updated {entry['id']}:")
    for change in changes:
        print(f"  {change}")
    if lab.started and (args.title or args.goal or args.no_goals):
        print(f"  The learner already started it, so their {rel(lab.log)} keeps the old title and goals.")
    print("  Run `bin/sync` to send it to the learner.")


# ---------------------------------------------------------------- lectures
# Lecture notes belong to a phase, not a chapter: <phase dir>/lectures/*.md, in file-name
# order (number them: 01-..., 02-...). Images and other files can sit next to them.
# Nothing is listed in curriculum.json; the folder is the list.

def lectures(phase):
    folder = ROOT / phase["dir"] / "lectures"
    if not folder.is_dir():
        return []
    return sorted(p for p in folder.glob("*.md") if p.is_file())


def cmd_lectures(args):
    phases = load_curriculum()["phases"]
    if args.phase is not None:
        phases = [phases[phase_index(phases, args.phase)]]
    found = 0
    for phase in phases:
        files = lectures(phase)
        if not files:
            continue
        print(f"\n{phase['title']}")
        for path in files:
            print(f"  {lecture_id(phase, path):<6} {readme_title_of(path):<44} {rel(path)}")
        found += len(files)
    if not found:
        print("No lectures yet.")


def readme_title_of(path):
    """A Markdown file's first # heading, else its name without the number prefix."""
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return re.sub(r"^\d+[-_ ]*", "", path.stem).replace("-", " ").replace("_", " ").capitalize()


def cmd_lecture_new(args):
    """Mentor: start a new lecture from templates/lecture.md as the next numbered file in a phase."""
    subject = " ".join(args.subject).strip()
    slug = slugify(subject)
    if not slug:
        die("give the lecture a subject, e.g. `lecture new \"How the web works\"`.")
    phases = load_curriculum()["phases"]
    index = phase_index(phases, args.phase) if args.phase is not None else current_phase(load_chapters())
    phase = phases[index]
    folder = ROOT / phase["dir"] / "lectures"
    existing = lectures(phase)
    for path in existing:
        if re.sub(r"^\d+[-_ ]*", "", path.stem) == slug:
            die(f"{rel(path)} is already about that. Edit it, or pick another subject.")
    numbers = [int(m.group()) for m in (re.match(r"\d+", p.name) for p in existing) if m]
    number = max(numbers, default=0) + 1
    path = folder / f"{number:02d}-{slug}.md"
    template = TEMPLATE_DIR / "lecture.md"
    title = subject[0].upper() + subject[1:]
    text = (fill(template.read_text(encoding="utf-8"), {"title": title, "phase": phase["title"], "date": today()})
            if template.exists() else f"# {title}\n")
    folder.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    print(f"created {lecture_id(phase, path)} · {rel(path)}" + (f" from {rel(template)}" if template.exists() else ""))
    print(f"  Write it with `bin/learn lecture edit {lecture_id(phase, path)}`, then run `bin/sync` to send it to the learner.")


def phase_number(phase):
    return int(re.match(r"phase-(\d+)", phase["dir"]).group(1))


def lecture_id(phase, path):
    """'1.2' for phase-1-*/lectures/02-*.md; a lecture without a number uses its name instead."""
    match = re.match(r"\d+", path.name)
    return f"{phase_number(phase)}.{int(match.group()) if match else path.stem}"


def find_lecture(wanted, phase_arg=None):
    """A lecture by id ('1.2'), by number in the current phase ('2'), or by part of its name ('http')."""
    phases = load_curriculum()["phases"]
    every = [(ph, path) for ph in phases for path in lectures(ph)]
    if phase_arg is not None:
        every = [(ph, path) for ph, path in every if phase_number(ph) == phase_arg]
    wanted = wanted.strip().lower()
    if re.fullmatch(r"\d+", wanted):
        number = phase_arg if phase_arg is not None else phase_number(phases[current_phase(load_chapters())])
        wanted = f"{number}.{int(wanted)}"
    matches = [(ph, path) for ph, path in every if lecture_id(ph, path) == wanted]
    if not matches:
        matches = [(ph, path) for ph, path in every if wanted in path.stem.lower()]
    if len(matches) == 1:
        return matches[0]
    if matches:
        die(f"'{wanted}' matches several lectures: "
            + ", ".join(f"{lecture_id(ph, path)} ({path.name})" for ph, path in matches))
    die(f"no lecture '{wanted}'. See the ids with `bin/learn lectures`.")


def terminal_editor():
    """The command-line editor to use: $VISUAL, $EDITOR, git's core.editor, then nano, vim or vi."""
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not editor:
        try:
            editor = subprocess.run(["git", "config", "core.editor"], cwd=ROOT,
                                    capture_output=True, text=True).stdout.strip()
        except OSError:
            editor = ""
    if not editor:
        editor = next((name for name in ("nano", "vim", "vi") if shutil.which(name)), "")
    return editor


def open_in_editor(path, editor):
    """Open path in a command-line editor, in this terminal, and wait until it's closed."""
    try:
        return subprocess.call(shlex.split(editor) + [str(path)])
    except (OSError, ValueError) as error:
        die(f"couldn't start '{editor}' ({error}). Set $EDITOR to an editor you have, e.g. `export EDITOR=nano`.")


def cmd_lecture_edit(args):
    """Mentor: open a lecture in your editor."""
    phase, path = find_lecture(args.id, args.phase)
    editor = terminal_editor()
    if not editor:
        die(f"no command-line editor found. Set one with `export EDITOR=nano`, or open {rel(path)} yourself.")
    print(f"opening {lecture_id(phase, path)} · {readme_title_of(path)}  ({rel(path)}) in {editor}", flush=True)
    if open_in_editor(path, editor):
        die(f"the editor exited with an error. The file is {rel(path)}.")


# ---------------------------------------------------------------- CLI

def main():
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(errors="replace")   # don't crash on ✓ ▶ in older Windows consoles
    chapter_opt = argparse.ArgumentParser(add_help=False)
    chapter_opt.add_argument("-c", "--chapter", help="chapter id (default: your current chapter)")

    parser = argparse.ArgumentParser(
        prog="bin/learn",
        description="Keep your chapter logs up to date. Commands that change a log work on your "
                    "current chapter unless you pass -c <id>.",
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")

    def add(name, func, help_text, parents=()):
        p = sub.add_parser(name, help=help_text, description=help_text, parents=list(parents))
        p.set_defaults(func=func)
        return p

    add("status", cmd_status, "show every chapter and its progress").add_argument(
        "phase", nargs="?", type=int, help="show only this phase number")
    add("start", cmd_start, "make a chapter current and mark it in progress").add_argument("id")
    p = add("ex", cmd_ex, "create a new exercise file and list it in the log", [chapter_opt])
    p.add_argument("id", help="exercise number from the book, e.g. 4-3")
    p.add_argument("title", nargs="*", help="exercise title, e.g. Counting to Twenty")
    add("done", cmd_done, "tick off an exercise", [chapter_opt]).add_argument("id")
    p = add("session", cmd_session, "start today's session: pick the chapter and add an entry to fill in", [chapter_opt])
    p.add_argument("id", nargs="?", help="chapter to work on today; it becomes the current chapter (default: current)")
    p.add_argument("--hours", type=float, help="hours studied today")
    add("note", cmd_note, "add a remark", [chapter_opt]).add_argument("text", nargs="+")
    add("ask", cmd_ask, "log a question for your mentor", [chapter_opt]).add_argument("text", nargs="+")
    p = add("answered", cmd_answered, "mark open question <n> as answered", [chapter_opt])
    p.add_argument("number", type=int)
    p.add_argument("answer", nargs="*", help="short summary of the answer")
    add("park", cmd_park, "park something unfinished to come back to", [chapter_opt]).add_argument("text", nargs="+")
    p = add("unpark", cmd_unpark, "mark open parked item <n> as done", [chapter_opt])
    p.add_argument("number", type=int)
    p.add_argument("note", nargs="*", help="optional note on how it was finished")
    add("parked", cmd_parked, "list everything still parked, in every chapter")
    add("questions", cmd_questions, "list every unanswered question")
    p = add("complete", cmd_complete, "mark a chapter complete (checks for loose ends first)", [chapter_opt])
    p.add_argument("id", nargs="?", help="chapter id (default: current)")
    p.add_argument("--force", action="store_true", help="complete even with loose ends")
    p = add("next", cmd_next, "close the current chapter and move to the next one", [chapter_opt])
    p.add_argument("--force", action="store_true", help="close it even with loose ends")
    p = add("skip", cmd_skip, "mark a chapter skipped, e.g. a project track you didn't pick")
    p.add_argument("id")
    p.add_argument("reason", nargs="*")
    add("labs", cmd_labs, "list the labs: optional real-world walkthroughs, by phase")
    # Mentor-only, so it's left out of `-h` (a subcommand without help= isn't listed). See MENTOR.md.
    lab = sub.add_parser("lab", description="mentor: manage labs (see `lab <command> -h`)")
    lab_sub = lab.add_subparsers(dest="lab_command", metavar="<lab command>")
    lab.set_defaults(func=lambda a: lab.print_help())
    p = lab_sub.add_parser("add", help="copy a folder in as a lab of the current phase",
                           description="Copy a folder in as <phase>/labs/<name>/ and list it in curriculum.json. "
                                       "Its README.md is the walkthrough; every other file goes into starter/, "
                                       "which the learner gets a copy of in exercises/ when they start the lab. "
                                       "The phase is the learner's current one unless you pass --phase.")
    p.set_defaults(func=cmd_lab_add)
    p.add_argument("folder", help="the folder to add, from anywhere on disk")
    p.add_argument("--phase", type=int, help="phase number (default: the learner's current phase)")
    p.add_argument("--title", help="default: the README's first # heading, else the folder name")
    p.add_argument("--needs", help="chapter the lab builds on; the learner is told when it's ready")
    p.add_argument("--goal", action="append", help="a goal for the log's checklist (repeat for more)")
    p.add_argument("--id", help="lab id (default: lab-<folder name>)")
    p.add_argument("--update", action="store_true", help="copy in a newer version of a lab that's already added")
    p = lab_sub.add_parser("list", help="every lab with its source, setup and the learner's progress",
                           description="Every lab with its source folder, starter files, needs, goals "
                                       "and the learner's progress.")
    p.set_defaults(func=cmd_lab_list)
    p = lab_sub.add_parser("remove", help="take a lab out and delete its folder",
                           description="Take a lab out of curriculum.json and delete its folder. If the "
                                       "learner started it, only README.md and starter/ are deleted; their "
                                       "LOG.md and exercises/ are never touched.")
    p.set_defaults(func=cmd_lab_remove)
    p.add_argument("id")
    p.add_argument("--force", action="store_true", help="remove it even though the learner started it")
    p = lab_sub.add_parser("edit", help="change a lab's title, needs, goals or phase",
                           description="Change a lab's details in curriculum.json without copying its files "
                                       "again. Use `lab add <folder> --update` to replace the files.")
    p.set_defaults(func=cmd_lab_edit)
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--needs", help="chapter the lab builds on")
    p.add_argument("--no-needs", action="store_true", help="the lab doesn't depend on a chapter")
    p.add_argument("--goal", action="append", help="replaces the goals (repeat for more)")
    p.add_argument("--no-goals", action="store_true", help="go back to the default goals")
    p.add_argument("--phase", type=int, help="move it to another phase (only before the learner starts it)")
    add("lectures", cmd_lectures, "list the lecture notes, by phase").add_argument(
        "phase", nargs="?", type=int, help="show only this phase number")
    # Mentor-only, left out of `-h` like `lab`.
    lecture = sub.add_parser("lecture", description="mentor: write lecture notes (see `lecture <command> -h`)")
    lecture_sub = lecture.add_subparsers(dest="lecture_command", metavar="<lecture command>")
    lecture.set_defaults(func=lambda a: lecture.print_help())
    p = lecture_sub.add_parser("new", help="start a new lecture from templates/lecture.md",
                               description="Create the next numbered lecture (e.g. 03-how-the-web-works.md) in "
                                           "<phase>/lectures/ from templates/lecture.md, with the subject as its "
                                           "title. Creates lectures/ if the phase doesn't have one yet. The phase "
                                           "is the learner's current one unless you pass --phase.")
    p.set_defaults(func=cmd_lecture_new)
    p.add_argument("subject", nargs="+", help='what it\'s about, e.g. "How the web works"')
    p.add_argument("--phase", type=int, help="phase number (default: the learner's current phase)")
    p = lecture_sub.add_parser("edit", help="open a lecture in your editor",
                               description="Open a lecture in your command-line editor, in this terminal: $VISUAL, "
                                           "$EDITOR, git's core.editor, else nano, vim or vi. Pick it by id from `lectures` (1.2 = phase 1, lecture 02), "
                                           "by number in the current phase (2), or by part of its name (http).")
    p.set_defaults(func=cmd_lecture_edit)
    p.add_argument("id", help="e.g. 1.2, 2 or http")
    p.add_argument("--phase", type=int, help="look only in this phase")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return
    args.func(args)


if __name__ == "__main__":
    main()
